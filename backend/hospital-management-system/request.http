}

### 28. Edge case – doctor not found
GET {{baseUrl}}/api/doctors/99999

### 29. Edge case – doctor with non-existent userId (400 Bad Request)
POST {{baseUrl}}/api/doctors
Content-Type: application/json

{
  "userId": 99999,
  "name": "Dr. Ghost",
  "email": "dr.ghost@example.com",
  "phone": "9999999999",
  "specialization": "General Physician",
  "qualification": "MBBS",
  "experienceYears": 2,
  "consultationFee": 500.00,
  "slotDurationMinutes": 30
}

### 30. Edge case – doctor with already-linked userId (409 Conflict)
POST {{baseUrl}}/api/doctors
Content-Type: application/json

{
  "userId": 2,
  "name": "Dr. Conflict",
  "email": "dr.conflict@example.com",
  "phone": "9999999998",
  "specialization": "Cardiologist",
  "qualification": "MBBS, MD",
  "experienceYears": 5,
  "consultationFee": 700.00,
  "slotDurationMinutes": 30
}


### ───────────────────────────────────────────────────────────────
###  DOCTOR AVAILABILITY  (/api/doctors/{id}/availability)
### ───────────────────────────────────────────────────────────────

### 29. Set full weekly schedule for doctor 1
PUT {{baseUrl}}/api/doctors/1/availability
Content-Type: application/json

[
  {
    "dayOfWeek": "MONDAY",
    "startTime": "09:00",
    "endTime": "17:00",
    "breaksJson": "[{\"startTime\":\"13:00\",\"endTime\":\"14:00\"}]",
    "timezone": "Asia/Kolkata"
  },
  {
    "dayOfWeek": "TUESDAY",
    "startTime": "09:00",
    "endTime": "17:00",
    "breaksJson": "[{\"startTime\":\"13:00\",\"endTime\":\"14:00\"}]",
    "timezone": "Asia/Kolkata"
  },
  {
    "dayOfWeek": "WEDNESDAY",
    "startTime": "09:00",
    "endTime": "17:00",
    "breaksJson": "[{\"startTime\":\"13:00\",\"endTime\":\"14:00\"}]",
    "timezone": "Asia/Kolkata"
  },
  {
    "dayOfWeek": "THURSDAY",
    "startTime": "09:00",
    "endTime": "17:00",
    "breaksJson": "[{\"startTime\":\"13:00\",\"endTime\":\"14:00\"}]",
    "timezone": "Asia/Kolkata"
  },
  {
    "dayOfWeek": "FRIDAY",
    "startTime": "09:00",
    "endTime": "17:00",
    "breaksJson": "[{\"startTime\":\"13:00\",\"endTime\":\"14:00\"}]",
    "timezone": "Asia/Kolkata"
  },
  {
    "dayOfWeek": "SATURDAY",
    "startTime": "09:00",
    "endTime": "13:00",
    "breaksJson": "[]",
    "timezone": "Asia/Kolkata"
  }
]

### 30. Get full schedule for doctor 1
GET {{baseUrl}}/api/doctors/1/availability

### 31. Get Monday schedule for doctor 1
GET {{baseUrl}}/api/doctors/1/availability/MONDAY

### 32. Update only Thursday schedule
PUT {{baseUrl}}/api/doctors/1/availability/THURSDAY
Content-Type: application/json

{
  "dayOfWeek": "THURSDAY",
  "startTime": "10:00",
  "endTime": "16:00",
  "breaksJson": "[{\"startTime\":\"13:00\",\"endTime\":\"13:30\"}]",
  "timezone": "Asia/Kolkata"
}

### 33. Remove Sunday from schedule
DELETE {{baseUrl}}/api/doctors/1/availability/SUNDAY

### 34. Clear entire schedule for doctor 1
DELETE {{baseUrl}}/api/doctors/1/availability


