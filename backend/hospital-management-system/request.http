### ───────────────────────────────────────────────────────────────
###  MEDICATIONS  (/api/patients/{id}/medications)
### ───────────────────────────────────────────────────────────────

### 45. Add medication for patient 1
POST {{baseUrl}}/api/patients/1/medications
Content-Type: application/json

{
  "name": "Telmisartan 40mg",
  "dosage": "1 tablet daily",
  "frequency": "Morning after breakfast",
  "doctorName": "Dr. Amit Sharma",
  "refillStatus": "ACTIVE"
}

### 46. Add second medication for patient 1
POST {{baseUrl}}/api/patients/1/medications
Content-Type: application/json

{
  "name": "Vitamin D3 60K",
  "dosage": "1 capsule weekly",
  "frequency": "Sunday with milk",
  "doctorName": "Dr. Amit Sharma",
  "refillStatus": "REFILL_DUE"
}

### 47. Add medication for patient 2
POST {{baseUrl}}/api/patients/2/medications
Content-Type: application/json

{
  "name": "Cetirizine 10mg",
  "dosage": "1 tablet as needed",
  "frequency": "At night",
  "doctorName": "Dr. Meera Nambiar",
  "refillStatus": "ACTIVE"
}

### 48. Get medications for patient 1
GET {{baseUrl}}/api/patients/1/medications

### 49. Update medication 1 for patient 1
PUT {{baseUrl}}/api/patients/1/medications/1
Content-Type: application/json

{
  "name": "Telmisartan 40mg",
  "dosage": "1 tablet daily",
  "frequency": "Morning after breakfast",
  "doctorName": "Dr. Amit Sharma",
  "refillStatus": "REFILL_DUE"
}

### 50. Delete medication 2 from patient 1
DELETE {{baseUrl}}/api/patients/1/medications/2


