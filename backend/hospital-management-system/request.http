PATCH {{baseUrl}}/api/appointments/1/status
Content-Type: application/json

{
  "status": "COMPLETED"
}

### 66. Update appointment status to NO_SHOW
PATCH {{baseUrl}}/api/appointments/1/status
Content-Type: application/json

{
  "status": "NO_SHOW"
}

### 67. Reschedule appointment
PATCH {{baseUrl}}/api/appointments/2/reschedule
Content-Type: application/json

{
  "appointmentDate": "2026-11-15",
  "startTime": "11:00",
  "endTime": "11:30"
}

### 68. Cancel appointment (soft-delete via status update)
DELETE {{baseUrl}}/api/appointments/3

### 69. Edge case – double-book same slot (409 Conflict)
POST {{baseUrl}}/api/appointments
Content-Type: application/json

{
  "patientId": 2,
  "doctorId": 1,
  "appointmentDate": "2026-11-02",
  "startTime": "10:00",
  "endTime": "10:30",
  "reason": "Same slot conflict test",
  "consultationType": "IN_PERSON"
}

### 70. Edge case – invalid status update
PATCH {{baseUrl}}/api/appointments/1/status
Content-Type: application/json

{
  "status": "INVALID_STATUS"
}

### 71. Edge case – appointment with non-existent doctor
POST {{baseUrl}}/api/appointments
Content-Type: application/json

{
  "patientId": 1,
  "doctorId": 99999,
  "appointmentDate": "2026-12-01",
  "startTime": "09:00",
  "endTime": "09:30",
  "reason": "Test",
  "consultationType": "IN_PERSON"
}

### 72. Edge case – appointment with non-existent patient
POST {{baseUrl}}/api/appointments
Content-Type: application/json

{
  "patientId": 99999,
  "doctorId": 1,
  "appointmentDate": "2026-12-01",
  "startTime": "09:00",
  "endTime": "09:30",
  "reason": "Test",
  "consultationType": "IN_PERSON"
}

